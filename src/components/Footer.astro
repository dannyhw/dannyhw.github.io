---
import { SITE_TITLE } from "../consts";
import OrbitMark from "./OrbitMark.astro";

const today = new Date();
---

<footer class="ow-footer">
  <div class="ow-footer-inner">
    <div class="ow-brand">
      <OrbitMark size={20} />
      <span>{SITE_TITLE}</span>
    </div>
    <span class="ow-foot-note">&copy; {today.getFullYear()} Daniel Williams</span>
    <div class="ow-foot-links">
      <a href="https://github.com/dannyhw" target="_blank" rel="noopener">GitHub</a>
      <a href="https://x.com/Danny_H_W" target="_blank" rel="noopener">Twitter</a>
      <a href="https://www.linkedin.com/in/danielhwilliams/" target="_blank" rel="noopener"
        >LinkedIn</a
      >
      <a href="/rss.xml">RSS</a>
      <a href="#" data-theme-toggle>
        <span class="ow-foot-theme-label--light">Dark mode</span>
        <span class="ow-foot-theme-label--dark">Light mode</span>
      </a>
    </div>
  </div>
</footer>
