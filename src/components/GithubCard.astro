---
interface Props {
  name: string;
  tagLine: string;
  href: string;
  stars?: string;
  language?: string;
  tag?: string;
}

const { name, tagLine, href, stars, language, tag } = Astro.props;
const isProfile = tag === "profile";
---

<a class="orbit-card orbit-card--interactive ow-repo" href={href} target="_blank" rel="noopener">
  <div class="orbit-card__body">
    <div class="ow-repo-top">
      <h3>{name}</h3>
      {
        isProfile ? (
          <span class="orbit-badge orbit-badge--neutral">github</span>
        ) : (
          <span class="orbit-badge orbit-badge--accent">{tag}</span>
        )
      }
    </div>
    <p class="ow-repo-desc">{tagLine}</p>
    <div class="ow-repo-meta">
      {
        language && (
          <span class="ow-lang">
            <i class="ow-langdot" />
            {language}
          </span>
        )
      }
      {stars && <span>★ {stars}</span>}
      {isProfile && <span>github.com/dannyhw →</span>}
    </div>
  </div>
</a>
