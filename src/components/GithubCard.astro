---
interface Props {
  name: string;
  tagLine: string;
  href: string;
  stars?: string;
  downloads?: string;
  language?: string;
  tag?: string;
}

const { name, tagLine, href, stars, downloads, language, tag } = Astro.props;
const isProfile = tag === "profile";
const hasMeta = Boolean(language || stars || downloads || isProfile);
---

<a class="orbit-card orbit-card--interactive ow-repo" href={href} target="_blank" rel="noopener">
  <div class="orbit-card__body">
    <div class="ow-repo-top">
      <h3>{name}</h3>
      {
        isProfile && (
          <span class="orbit-badge orbit-badge--neutral">github</span>
        )
      }
    </div>
    <p class="ow-repo-desc">{tagLine}</p>
    {hasMeta && <div class="ow-repo-meta">
      {
        language && (
          <span class="ow-lang">
            <i class="ow-langdot" />
            {language}
          </span>
        )
      }
      {
        stars && (
          <span class="ow-repo-stat ow-repo-stars">
            <svg
              viewBox="0 0 16 16"
              fill="currentColor"
              aria-hidden="true"
              width="16"
              height="16"
            >
              <path
                d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.819 6.328a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25z"
              />
            </svg>
            {stars}
          </span>
        )
      }
      {
        downloads && (
          <span class="ow-repo-stat ow-repo-downloads">
            <svg
              viewBox="0 0 16 16"
              fill="currentColor"
              aria-hidden="true"
              width="16"
              height="16"
            >
              <path
                d="M8 1.5a.75.75 0 0 1 .75.75v6.59l1.95-1.95a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L3.22 8.85a.75.75 0 1 1 1.06-1.06l1.95 1.95V2.25A.75.75 0 0 1 8 1.5ZM3.75 12a.75.75 0 0 0 0 1.5h8.5a.75.75 0 0 0 0-1.5h-8.5Z"
              />
            </svg>
            {downloads}
          </span>
        )
      }
      {isProfile && <span>github.com/dannyhw →</span>}
    </div>}
  </div>
</a>
