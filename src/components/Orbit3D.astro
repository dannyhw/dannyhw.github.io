---
/* 3D orbital system of stack logos — drag to rotate/tilt, idle auto-spin.
   Ported from the Orbit design prototype (brand-color logos, billboarded
   so they stay readable as they travel around the ring). */
import OrbitMark from "./OrbitMark.astro";

const R = 212; // orbit radius
const REST_X = -31; // resting tilt

const logos = [
  { key: "react", beam: true },
  { key: "storybook", beam: true },
  { key: "github", beam: false },
  { key: "typescript", beam: false },
  { key: "javascript", beam: false },
  { key: "node", beam: false },
  { key: "expo", beam: false },
];

const chipTransform = (i: number) => {
  const a = (360 / logos.length) * i;
  return `rotateY(${a}deg) translateZ(${R}px) rotateY(${-a}deg)`;
};
---

<div class="ow-stage3d" data-orbit3d data-radius={R} data-rest-x={REST_X}>
  <div class="ow-orbit3d" data-orbit-group style={`transform: rotateX(${REST_X}deg) rotateY(0deg)`}>
    <div class="ow-orbit-ring" style={`width: ${R * 2}px; height: ${R * 2}px`}></div>
    <div
      class="ow-orbit-ring ow-orbit-ring--beam"
      style={`width: ${R * 2 + 56}px; height: ${R * 2 + 56}px`}
    >
    </div>

    <div class="ow-orbit-core" data-orbit-core style="transform: rotateY(0deg)">
      <OrbitMark size={46} />
    </div>

    {
      logos.map((logo, i) => (
        <div
          class:list={["ow-chip3d", { "ow-chip3d--beam": logo.beam }]}
          data-label={logo.key}
          data-orbit-chip
          style={`transform: ${chipTransform(i)}`}
        >
          {logo.key === "react" && (
            <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
              <circle cx="24" cy="24" r="3.4" fill="#61DAFB" />
              <g stroke="#61DAFB" stroke-width="1.8" fill="none">
                <ellipse cx="24" cy="24" rx="19" ry="7.3" />
                <ellipse cx="24" cy="24" rx="19" ry="7.3" transform="rotate(60 24 24)" />
                <ellipse cx="24" cy="24" rx="19" ry="7.3" transform="rotate(120 24 24)" />
              </g>
            </svg>
          )}
          {logo.key === "storybook" && (
