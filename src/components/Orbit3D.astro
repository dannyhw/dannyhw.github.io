  </div>

  <div class="ow-hint3d">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      ><polyline points="5 9 2 12 5 15"></polyline><polyline points="9 5 12 2 15 5"></polyline><polyline
        points="15 19 12 22 9 19"></polyline><polyline points="19 9 22 12 19 15"></polyline><line
        x1="2"
        y1="12"
        x2="22"
        y2="12"></line><line x1="12" y1="2" x2="12" y2="22"></line></svg
    >
    drag to rotate
  </div>
</div>

<script>
  function initOrbit(stage: HTMLElement) {
    const group = stage.querySelector<HTMLElement>("[data-orbit-group]");
    const core = stage.querySelector<HTMLElement>("[data-orbit-core]");
    const chips = Array.from(stage.querySelectorAll<HTMLElement>("[data-orbit-chip]"));
    if (!group || !chips.length) return;

    const R = Number(stage.dataset.radius) || 212;
    const restX = Number(stage.dataset.restX) || -31;
    const N = chips.length;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const s = { rotX: restX, rotY: 0, velY: 0, dragging: false, lastX: 0, lastY: 0 };
    let lastFrame = "";

    const apply = () => {
      const frame = `${s.rotX.toFixed(2)},${s.rotY.toFixed(2)}`;
      if (frame === lastFrame) return;
      lastFrame = frame;
      group.style.transform = `rotateX(${s.rotX}deg) rotateY(${s.rotY}deg)`;
      // billboard chips against Y so logos stay readable; keep group X tilt for depth
      chips.forEach((el, i) => {
        const a = (360 / N) * i;
        el.style.transform = `rotateY(${a}deg) translateZ(${R}px) rotateY(${-a - s.rotY}deg)`;
      });
      if (core) core.style.transform = `rotateY(${-s.rotY}deg)`;
    };

    let raf = 0;
    const tick = () => {
      if (!s.dragging) {
        if (Math.abs(s.velY) > 0.02) {
          s.rotY += s.velY;
          s.velY *= 0.95;
        } else if (!reduce) {
          s.rotY += 0.16;
        }
        s.rotX += (restX - s.rotX) * 0.05;
      }
      apply();
      raf = requestAnimationFrame(tick);
    };

    // only animate while the stage is on screen
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        if (!raf) raf = requestAnimationFrame(tick);
      } else if (raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    }).observe(stage);

    stage.addEventListener("pointerdown", (e) => {
      s.dragging = true;
      s.velY = 0;
      s.lastX = e.clientX;
      s.lastY = e.clientY;
      try {
        stage.setPointerCapture(e.pointerId);
      } catch (_) {}
    });
    stage.addEventListener("pointermove", (e) => {
      if (!s.dragging) return;
      const dx = e.clientX - s.lastX;
      const dy = e.clientY - s.lastY;
      s.rotY += dx * 0.35;
      s.rotX = Math.max(-78, Math.min(28, s.rotX - dy * 0.35));
      s.velY = dx * 0.35;
      s.lastX = e.clientX;
      s.lastY = e.clientY;
    });
    const stop = () => {
      s.dragging = false;
    };
    stage.addEventListener("pointerup", stop);
    stage.addEventListener("pointercancel", stop);
  }

  document.querySelectorAll<HTMLElement>("[data-orbit3d]").forEach(initOrbit);
</script>
