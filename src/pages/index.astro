---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import GithubCard from "../components/GithubCard.astro";
import Header from "../components/Header.astro";
import Orbit3D from "../components/Orbit3D.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const shortDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}`;

const technologies = [
  { name: "React Native", href: "https://reactnative.dev" },
  { name: "ReactJS", href: "https://react.dev/" },
  { name: "TypeScript", href: "https://www.typescriptlang.org/" },
  { name: "JavaScript", href: "https://ecma-international.org/publications-and-standards/standards/ecma-262/" },
  { name: "Storybook", href: "https://storybook.js.org/" },
  { name: "NodeJS", href: "https://nodejs.org" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <div class="ow-page">
      <Header />

      <!-- ── HERO — portrait-led ─────────────────── -->
      <section class="owp-hero orbit-grid-field">
        <div class="owp-hero-copy">
          <span class="orbit-eyebrow">{"// REACT & REACT NATIVE · OSS MAINTAINER"}</span>
          <h1 class="ow-hero-title">Daniel Williams</h1>
          <p class="ow-hero-lead">
            I build for <strong>React</strong> and <strong>React Native</strong>, web and
            mobile, across the stack. I maintain open source, and I write about what I
            learn.
          </p>
          <div class="ow-hero-cta">
            <a
              class="orbit-btn orbit-btn--primary orbit-btn--lg"
              href="https://github.com/dannyhw"
              target="_blank"
              rel="noopener"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
                ></path></svg
              >
              Star on GitHub
            </a>
            <a class="orbit-btn orbit-btn--outline orbit-btn--lg" href="/blog">
              Read the blog
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"
                ></polyline></svg
              >
            </a>
          </div>
        </div>

        <figure class="owp-portrait owp-portrait--glow">
          <img
            src="/photos/speaking-rn-porto.jpg"
            alt="Daniel Williams speaking at a React Native conference"
            width="619"
            height="631"
          />
          <figcaption>
            <span class="orbit-badge orbit-badge--accent"
              ><span class="orbit-badge__dot"></span>on stage</span
            >
            <span class="owp-portrait-cap">React Native Porto</span>
          </figcaption>
        </figure>
      </section>

      <!-- ── STACK — hosts the 3D orbit ──────────── -->
      <section class="owp-stack orbit-dot-field">
        <div class="owp-stack-head">
          <span class="orbit-eyebrow">{"// STACK"}</span>
          <h2>What I build with</h2>
          <p class="ow-section-sub">
            A tight set of tools I reach for every day, drag the system to spin it.
          </p>
          <div class="ow-hero-tags owp-stack-tags">
            {
              technologies.map((t) => (
                <a class="orbit-tag" href={t.href} target="_blank" rel="noopener">
                  {t.name}
                </a>
              ))
            }
          </div>
        </div>

        <Orbit3D />
      </section>

      <!-- ── OPEN SOURCE ─────────────────────────── -->
      <section class="ow-section">
        <div class="ow-section-head">
          <div>
            <span class="orbit-eyebrow">{"// OPEN SOURCE"}</span>
            <h2>Open source projects</h2>
            <p class="ow-section-sub">
              I'm a maintainer of React Native Storybook and other supporting libraries.
              I also build tooling for react-native-web on Vite.
            </p>
          </div>
        </div>
        <div class="ow-repo-grid">
          <GithubCard
            name="storybookjs/react-native"
            tagLine="Storybook for React Native. Build and test UI components in isolation, on device."
            href="https://github.com/storybookjs/react-native"
            stars="1k+"
            downloads="500k/week"
          />
          <GithubCard
            name="storybookjs/react-native-web-vite"
            tagLine="Run react-native-web in Storybook on Vite."
            href="https://github.com/storybookjs/react-native-web-vite"
            stars="75+"
            downloads="150k/week"
          />
          <GithubCard
            name="dannyhw/vite-plugin-rnw"
            tagLine="Vite plugin for react-native-web with drop-in support for building RNW apps."
            href="https://github.com/dannyhw/vite-plugin-rnw"
            downloads="100k/week"
          />
          <GithubCard
            name="dannyhw"
            tagLine="For more, visit my GitHub profile…"
            href="https://github.com/dannyhw"
            tag="profile"
          />
        </div>
      </section>

      <!-- ── TALKS & COMMUNITY ───────────────────── -->
      <section class="ow-section">
        <div class="ow-section-head">
          <div>
            <span class="orbit-eyebrow">{"// IN THE WILD"}</span>
            <h2>Talks &amp; community</h2>
            <p class="ow-section-sub">
              I speak about React Native, Storybook and developer tooling at conferences
              and meetups. I also co-organise React Native Porto.
            </p>
          </div>
        </div>
        <div class="owp-gallery">
          <figure class="owp-shot owp-shot--wide">
            <img
              src="/photos/maintainers-panel.jpg"
              alt="Daniel Williams on the closing panel at React Native Universe"
              loading="lazy"
              width="1600"
              height="1067"
            />
            <figcaption>Closing panel · React Native Universe</figcaption>
          </figure>
          <figure class="owp-shot">
            <img
              src="/photos/conference-crowd.jpg"
              alt="Daniel Williams in the audience at a developer conference"
              loading="lazy"
              width="933"
              height="1400"
            />
            <figcaption>In the crowd</figcaption>
          </figure>
        </div>
      </section>

      <!-- ── RECENT POSTS ────────────────────────── -->
      <section class="ow-section">
        <div class="ow-section-head">
          <div>
            <span class="orbit-eyebrow">{"// WRITING"}</span>
            <h2>Recent posts</h2>
          </div>
          <a class="ow-viewall" href="/blog">View all →</a>
        </div>
        <ul class="ow-postlist">
          {
            posts.map((post) => (
              <li>
                <a class="ow-postrow" href={`/blog/${post.slug}/`}>
                  <span class="ow-postrow-date">{shortDate(post.data.pubDate)}</span>
                  <span class="ow-postrow-title">{post.data.title}</span>
                  <span class="ow-postrow-meta">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      width="15"
                      height="15"
                    >
                      <line x1="5" y1="12" x2="19" y2="12" />
                      <polyline points="12 5 19 12 12 19" />
                    </svg>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <Footer />
    </div>
  </body>
</html>
